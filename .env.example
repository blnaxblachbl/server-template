# postgress
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
DATABASE_NAME="template"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${DATABASE_NAME}?schema=public"

# seed
USER_EMAIL="admin@template.com"
USER_PASSWORD="123123"

# app
ACCESS_TOKEN_SECRET="ACCESS_TOKEN_SECRET"
REFRESH_TOKEN_SECRET="REFRESH_TOKEN_SECRET"
SESSION_TOKEN_SECRET="SESSION_TOKEN_SECRET"

# MAX_IMAGE_UPLOAD_SIZE="20971520" # optional, default = "20971520"
# MAX_JSON_UPLOAD_SIZE="1048576" # optional, default = "1048576"
# CORS='["http://localhost:4000", "http://localhost:3000"]' # optioanal, should be array of string, default = "*"
# PORT="4000" # optional, REST and GraphQL port, default = "4000"
# REST_API_ENABLED="true" # optionsal, default = "true"
# REST_API_PATH="/api" # optional, default = "/api"
# REST_API_KEY="REST_API_KEY"
# GRAPHQL_API_ENABLED="true" # optioanal, default = "true"
# GRAPHQL_API_INTROSPECTION="true" # optioanal, default = "true"
# GRAPHQL_API_PATH="/graphql" # optioanal, default = "/graphql"
# GRPC_PORT="4051" # optional, gRPC port, default = 4051
# GRPC_API_ENABLED="true" # optioanal, default = "true"
# GRPC_API_REFLECTION="true" # optioanal, default = "true"
